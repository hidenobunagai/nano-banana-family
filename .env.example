# ===========================================
# Environment Variables for Nano Banana Family
# ===========================================
# Copy this file to .env.local and fill in the values
# Or use: bun run env:encrypt (encrypts .env.local via dotenvx)

# -------------------------------------------
# Required: Gemini API
# -------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------
# Required: Authentication
# -------------------------------------------
# AUTH_SECRET is preferred; NEXTAUTH_SECRET is also supported as fallback
AUTH_SECRET=your_auth_secret_here
# NEXTAUTH_SECRET=your_auth_secret_here

# -------------------------------------------
# Optional: Google OAuth (for Google Sign-in)
# -------------------------------------------
AUTH_GOOGLE_ID=your_google_client_id_here
AUTH_GOOGLE_SECRET=your_google_client_secret_here

# -------------------------------------------
# Required: Allowed Emails
# -------------------------------------------
# Comma-separated list of the Google accounts allowed to sign in.
# Required: an empty or missing list rejects every sign-in.
ALLOWED_EMAILS=user1@example.com,user2@example.com

# -------------------------------------------
# Optional: Gemini Model Configuration
# -------------------------------------------
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# -------------------------------------------
# Optional: NextAuth URL (for production deployments)
# -------------------------------------------
# NEXTAUTH_URL=https://your-domain.com

# -------------------------------------------
# Environment
# -------------------------------------------
# NODE_ENV is deliberately not listed: Next.js sets it per command
# (development for `next dev`, production for `next build` / `next start`).
# Exporting it here would make the production build run in development mode.
