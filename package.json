{
  "name": "nano-banana-family",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenvx run --convention=nextjs --ignore=MISSING_ENV_FILE -- next dev -p 3001",
    "build": "dotenvx run --convention=nextjs --ignore=MISSING_ENV_FILE -- next build",
    "start": "dotenvx run --convention=nextjs --ignore=MISSING_ENV_FILE -- next start",
    "lint": "eslint",
    "typecheck": "dotenvx run --convention=nextjs --ignore=MISSING_ENV_FILE -- tsc --noEmit",
    "test": "dotenvx run --convention=nextjs --ignore=MISSING_ENV_FILE -- vitest run",
    "test:watch": "dotenvx run --convention=nextjs --ignore=MISSING_ENV_FILE -- vitest",
    "test:coverage": "dotenvx run --convention=nextjs --ignore=MISSING_ENV_FILE -- vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:encrypt": "dotenvx encrypt -f .env.local",
    "env:ls": "dotenvx ls"
  },
  "dependencies": {
    "@google/genai": "^1.19.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "next": "^16.4.6",
    "next-auth": "^4.24.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@serwist/turbopack": "9.5.15",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "serwist": "9.5.15",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:typescript@^6.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "typescript-eslint": "^8.72.0"
  }
}
